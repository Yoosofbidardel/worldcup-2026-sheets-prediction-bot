# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token

# The Google Sheet to write into.
# Open the sheet in your browser; the ID is the long string in the URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Tab (worksheet) name that holds the scoring grid.
# In the original workbook this tab is literally named "AFC Asian Cup Qatar 2022".
WORKSHEET_NAME=AFC Asian Cup Qatar 2022

# Path to the Google service-account JSON key (see README for how to create it).
GOOGLE_CREDENTIALS_FILE=service_account.json

# Comma-separated Telegram numeric user IDs who can assign people and manage the bot.
# Get your own id by sending /whoami to the bot once it is running.
ADMIN_IDS=

# Football API (kickoff times → prediction deadlines). Same provider/key as the
# original bot: get a free key at https://www.football-data.org/client/register
# Leave blank to disable deadlines (matches then lock only when you enter a result).
FOOTBALL_API_KEY=
COMPETITION_CODE=WC
# How often to refresh kickoff times from the API, in hours.
KICKOFF_REFRESH_HOURS=6
# Timezone for displaying kickoff times to users (lock logic always uses UTC).
# e.g. Asia/Tehran, Europe/Amsterdam, America/New_York
DISPLAY_TZ=UTC
