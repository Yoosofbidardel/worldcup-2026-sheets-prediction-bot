# systemd unit — keeps the bot running 24/7 and restarts it on crash/reboot.
#
# Install (one time, as root on the server):
#   cp deploy/wc2026.service /etc/systemd/system/wc2026.service
#   # edit WorkingDirectory/ExecStart below if your path differs
#   systemctl daemon-reload
#   systemctl enable --now wc2026
#
# For a SECOND league, copy this to wc2026-b.service with a different
# WorkingDirectory (e.g. /opt/wc2026-leagueB) and enable it too.

[Unit]
Description=World Cup 2026 prediction bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/wc2026
ExecStart=/opt/wc2026/.venv/bin/python main.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
